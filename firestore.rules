rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() {
      return signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.reviewOwnerId
      );
    }
    match /users/{userId} { allow read, write: if signedIn() && request.auth.uid == userId; }
    match /socialAccounts/{id} { allow read: if ownsExisting(); allow write: if false; }
    match /socialPosts/{id} { allow read: if ownsExisting(); allow write: if false; }
    match /socialInsights/{id} { allow read: if ownsExisting(); allow write: if false; }
    match /scheduledPosts/{id} { allow read: if ownsExisting(); allow write: if false; }
    match /syncLogs/{id} { allow read, write: if false; }
    match /errorLogs/{id} { allow read, write: if false; }
    match /oauthStates/{id} { allow read, write: if false; }
  }
}
